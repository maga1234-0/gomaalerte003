rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /alerts/{alertId} {
      // READ: Publicly readable by anyone.
      // This allows clients to query for and display alerts.
      allow get: if true;
      allow list: if true;

      // CREATE: Any signed-in user can create an alert, but they must be the owner.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // UPDATE: Not allowed from the client.
      allow update: if false;

      // DELETE: Only the user who created the alert can delete it.
      // The `resource` variable refers to the document being deleted.
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
